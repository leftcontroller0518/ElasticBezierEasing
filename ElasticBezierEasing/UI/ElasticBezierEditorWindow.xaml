<Window x:Class="ElasticBezierEasing.UI.ElasticBezierEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="エラスティックベジェ エディタ"
        Width="640" Height="690" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#121212"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI, Meiryo UI, sans-serif">

    <Window.Resources>
        <!-- アイコンボタンスタイル -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#383838"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セグメント切り替えボタンスタイル（Out / In / InOut） -->
        <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#262626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A78F2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A78F2"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4C88FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2660D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#3A78F2"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. トップヘッダー（タイトル、モードセグメント、コード） -->
            <RowDefinition Height="Auto"/>
            <!-- 2. アイコンツールバー -->
            <RowDefinition Height="Auto"/>
            <!-- 3. メイングラフ領域 -->
            <RowDefinition Height="*"/>
            <!-- 4. プレビュー＆パラメーターコントロールバー -->
            <RowDefinition Height="Auto"/>
            <!-- 5. フッター -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. トップヘッダー: 「振動」＆モード選択＆カーブコード -->
        <Grid Grid.Row="0" Margin="18,12,18,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- タイトル -->
            <TextBlock Grid.Column="0" Text="振動" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>

            <!-- モード切り替えセグメント (Ease Out / Ease In / Ease In-Out) -->
            <Border Grid.Column="1" HorizontalAlignment="Left" Background="#1A1A1A" CornerRadius="6" Padding="2" BorderBrush="#2A2A2A" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Ease Out" Style="{StaticResource SegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsEaseOut, Mode=TwoWay}"/>
                    <RadioButton Content="Ease In" Style="{StaticResource SegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsEaseIn, Mode=TwoWay}"/>
                    <RadioButton Content="Ease In-Out" Style="{StaticResource SegmentRadioButtonStyle}"
                                 IsChecked="{Binding IsEaseInOut, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- カーブコード -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="コード:" FontSize="13" Foreground="#777777" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="CurveCodeTextBox" Text="{Binding CurveCode, UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Background="#1C1C1C" Foreground="#4FC3F7" BorderBrush="#333333" BorderThickness="1"
                         Padding="6,2" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace"
                         ToolTip="カーブのシリアルコード。数値を直接入力またはクリップボードにコピーできます"
                         KeyDown="CurveCodeTextBox_KeyDown"/>
            </StackPanel>
        </Grid>

        <!-- 2. アイコンツールバー -->
        <Grid Grid.Row="1" Margin="14,2,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- コピーボタン -->
                <Button Style="{StaticResource IconButtonStyle}" Click="CopyButton_Click" ToolTip="設定コードをクリップボードにコピー">
                    <Path Data="M 2,4 L 10,4 L 10,12 L 2,12 Z M 5,1 L 13,1 L 13,9" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- ペーストボタン -->
                <Button Style="{StaticResource IconButtonStyle}" Click="PasteButton_Click" ToolTip="クリップボードからコードを読み込んで適用">
                    <Path Data="M 4,2 L 10,2 L 10,5 L 4,5 Z M 2,4 L 3,4 L 3,13 L 11,13 L 11,4 L 12,4" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- プリセットボタン (☆) -->
                <Button x:Name="PresetButton" Style="{StaticResource IconButtonStyle}" Click="PresetButton_Click" ToolTip="プリセットの選択・保存">
                    <Path Data="M 7,0.5 L 9.2,5 L 14,5.7 L 10.5,9.1 L 11.3,14 L 7,11.7 L 2.7,14 L 3.5,9.1 L 0,5.7 L 4.8,5 Z" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- リセットボタン (ゴミ箱) -->
                <Button Style="{StaticResource IconButtonStyle}" Click="ResetButton_Click" ToolTip="標準設定 (Normal) にリセット">
                    <Path Data="M 1,3 L 13,3 M 5,3 L 5,1 L 9,1 L 9,3 M 3,3 L 3,13 L 11,13 L 11,3" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- 右側: プレビュー再生ボタン -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconButtonStyle}" Click="PlayPreviewButton_Click" ToolTip="アニメーションをプレビュー再生">
                    <Path Data="M 2,1 L 12,7 L 2,13 Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Width="13" Height="13" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- プリセットポップアップメニュー -->
        <Popup x:Name="PresetPopup" PlacementTarget="{Binding ElementName=PresetButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4" Width="260">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="プリセット選択" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Button Content="Soft" Style="{StaticResource FlatButtonStyle}" Padding="6,4" Command="{Binding ApplySoftCommand}" Click="ClosePopup_Click"/>
                        <Button Content="Normal" Style="{StaticResource FlatButtonStyle}" Padding="6,4" Margin="4,0,0,0" Command="{Binding ApplyNormalCommand}" Click="ClosePopup_Click"/>
                        <Button Content="Strong" Style="{StaticResource FlatButtonStyle}" Padding="6,4" Margin="4,0,0,0" Command="{Binding ApplyStrongCommand}" Click="ClosePopup_Click"/>
                    </UniformGrid>

                    <Separator Background="#333333" Margin="0,4,0,8"/>
                    <TextBlock Text="ユーザープリセット" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding UserPresets}" SelectedItem="{Binding SelectedUserPreset}"
                             DisplayMemberPath="Name" Background="#161616" Foreground="#E0E0E0" BorderBrush="#2D2D2D" Height="90" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Background="#161616" Foreground="#E0E0E0" BorderBrush="#333333" Padding="4,2"/>
                        <Button Grid.Column="1" Content="保存" Style="{StaticResource FlatButtonStyle}" Command="{Binding SavePresetCommand}" Margin="4,0,0,0" Padding="8,2"/>
                    </Grid>
                    <Button Content="選択プリセット削除" Style="{StaticResource FlatButtonStyle}" Command="{Binding DeletePresetCommand}" HorizontalAlignment="Stretch" Padding="6,2"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 3. メイングラフエリア（Alight Motionスタイル） -->
        <Border Grid.Row="2" Background="#0E0E0E" BorderBrush="#1C1C1C" BorderThickness="0,1,0,1">
            <Canvas x:Name="GraphCanvas" Background="Transparent" ClipToBounds="True"
                    MouseLeftButtonDown="GraphCanvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="GraphCanvas_MouseLeftButtonUp"
                    MouseMove="GraphCanvas_MouseMove"
                    MouseDown="GraphCanvas_MouseDown"
                    MouseUp="GraphCanvas_MouseUp"
                    MouseWheel="GraphCanvas_MouseWheel"
                    SizeChanged="GraphCanvas_SizeChanged">
                <Canvas.ContextMenu>
                    <ContextMenu Background="#1E1E1E" Foreground="#E0E0E0" BorderBrush="#333333" BorderThickness="1">
                        <MenuItem Header="表示をリセット (初期の大きさと位置に戻す)" Click="ResetView_Click" Foreground="#E0E0E0"/>
                    </ContextMenu>
                </Canvas.ContextMenu>

                <!-- グリッド描画用キャンバス -->
                <Canvas x:Name="GridCanvas"/>

                <!-- 基準線（0ライン、1ライン） -->
                <Path x:Name="ZeroLinePath" Stroke="#252525" StrokeThickness="1"/>
                <Path x:Name="OneLinePath" Stroke="#2A2A2A" StrokeThickness="1.2" StrokeDashArray="4,4"/>

                <!-- 比較用ゴースト曲線（変更前カーブ） -->
                <Path x:Name="GhostCurvePath" Stroke="#3A4048" StrokeThickness="1.8"/>

                <!-- メインエラスティック曲線 -->
                <Path x:Name="MainCurvePath" Stroke="#FFFFFF" StrokeThickness="2.4">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#4FC3F7" Opacity="0.35"/>
                    </Path.Effect>
                </Path>

                <!-- 上部水平バー（振幅・減衰レンジ）：○────────○ -->
                <Line x:Name="TopBarLine" Stroke="#E0E0E0" StrokeThickness="2" Cursor="SizeNS"/>
                <!-- 左丸（振幅調整ハンドル） -->
                <Ellipse x:Name="TopBarLeftKnob" Width="14" Height="14" Fill="#0E0E0E" Stroke="#FFFFFF" StrokeThickness="2.2" Cursor="SizeNS"
                         ToolTip="上下ドラッグ: 振幅（強さ）を調整"/>
                <!-- 右丸（減衰/終端調整ハンドル） -->
                <Ellipse x:Name="TopBarRightKnob" Width="14" Height="14" Fill="#0E0E0E" Stroke="#FFFFFF" StrokeThickness="2.2" Cursor="SizeAll"
                         ToolTip="ドラッグ: 減衰の早さと振幅を調整"/>

                <!-- 谷のコントロール（周期・減衰調整）：谷底●から真下に伸びる線＋先端○ -->
                <Line x:Name="ValleyStemLine" Stroke="#FFFFFF" StrokeThickness="2"/>
                <!-- 谷底のアンカーポイント（白実体丸） -->
                <Ellipse x:Name="ValleyAnchor" Width="10" Height="10" Fill="#FFFFFF" Cursor="Hand"
                         ToolTip="左右ドラッグ: 振動回数（周期）を調整"/>
                <!-- 谷ハンドルのノブ（中空白丸） -->
                <Ellipse x:Name="ValleyKnob" Width="15" Height="15" Fill="#0E0E0E" Stroke="#FFFFFF" StrokeThickness="2.2" Cursor="SizeAll"
                         ToolTip="ドラッグ: 左右で振動周期、上下で減衰深さを調整"/>

                <!-- 始点アンカー（左下 0,0） -->
                <Ellipse x:Name="StartAnchor" Width="9" Height="9" Fill="#FFFFFF"/>
                <!-- 終点アンカー（右端 1,1） -->
                <Ellipse x:Name="EndAnchor" Width="9" Height="9" Fill="#FFFFFF"/>
            </Canvas>
        </Border>

        <!-- 4. ミニプレビュー & パラメーターコントロールバー -->
        <Border Grid.Row="3" Background="#141414" BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- プレビュートラック -->
                    <RowDefinition Height="Auto"/>
                    <!-- パラメーター微調整スライダー列 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- リアルタイム動きプレビュー -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Grid.Column="1" Height="20" Background="#0C0C0C" CornerRadius="10" BorderBrush="#252525" BorderThickness="1" ClipToBounds="True">
                        <Canvas x:Name="PreviewTrackCanvas">
                            <!-- プレビュー球 -->
                            <Ellipse x:Name="PreviewBall" Width="14" Height="14" Fill="#3A78F2" Canvas.Top="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#3A78F2" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Border>
                </Grid>

                <!-- パラメーター微調整 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Amplitude -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="強さ (Amplitude)" FontSize="11" Foreground="#999999"/>
                            <TextBlock Text="{Binding AmplitudeText}" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0.1" Maximum="2.5" SmallChange="0.05" LargeChange="0.2"
                                Value="{Binding Amplitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Oscillation -->
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="振動回数 (Oscillation)" FontSize="11" Foreground="#999999"/>
                            <TextBlock Text="{Binding OscillationText}" FontSize="11" FontWeight="Bold" Foreground="#81C784" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0.5" Maximum="6.0" SmallChange="0.05" LargeChange="0.5"
                                Value="{Binding Oscillation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Damping -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="減衰 (Damping)" FontSize="11" Foreground="#999999"/>
                            <TextBlock Text="{Binding DampingText}" FontSize="11" FontWeight="Bold" Foreground="#BA68C8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.01" LargeChange="0.1"
                                Value="{Binding Damping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 5. フッター: 完了・キャンセル -->
        <Grid Grid.Row="4" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 操作ヘルプヒント -->
            <TextBlock Grid.Column="0" Text="上のバーで強さ・範囲 / 下のハンドルで周期・減衰をドラッグ調整"
                       FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="キャンセル" Style="{StaticResource FlatButtonStyle}" Width="90" Click="CancelButton_Click" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="OK" Style="{StaticResource AccentButtonStyle}" Width="90" Click="OkButton_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

